@page "/search"
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Nav.Search"]</PageTitle>

<div class="container page stack">
    <h1>@Loc["Nav.Search"]</h1>

    @if (HasQuery)
    {
        <p class="muted">
            @From <span aria-hidden="true">→</span> @To@(string.IsNullOrEmpty(Date) ? "" : $" · {Date}")
        </p>
    }

    <div class="card">
        <div class="card__body centered" style="min-height: 30vh;">
            <div class="centered__inner">
                <span class="centered__code">Soon</span>
                <h3>Trip search is being wired up</h3>
                <p class="muted">
                    Routes, schedules and live seat maps land in the next milestones.
                    Your search for <strong>@(From ?? "—")</strong> to <strong>@(To ?? "—")</strong> is noted.
                </p>
                <a class="btn btn--ghost" href="/">@Loc["NotFound.Home"]</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? From { get; set; }
    [SupplyParameterFromQuery] private string? To { get; set; }
    [SupplyParameterFromQuery] private string? Date { get; set; }

    private bool HasQuery => !string.IsNullOrWhiteSpace(From) || !string.IsNullOrWhiteSpace(To);
}
