@page "/staff/staff/new"
@page "/staff/staff/{Id:guid}"
@rendermode RenderModes.ServerNoPrerender
@attribute [Authorize(Policy = AuthPolicies.SuperAdmin)]
@inject StaffService Staff
@inject LocationService Locations
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add account" : "Edit account")</PageTitle>

<PageHeading Title="@(IsNew ? "Add a staff account" : $"Edit {_model.FullName}")" />

@if (_loading)
{
    <div class="loading-block">Loading…</div>
}
else
{
    <div class="card form-card">
        <div class="card__body">
            <EditForm Model="_model" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="field">
                        <label for="fullname">Full name</label>
                        <InputText id="fullname" class="input" @bind-Value="_model.FullName" />
                        <ValidationMessage For="() => _model.FullName" />
                    </div>
                    <div class="field">
                        <label for="username">Username</label>
                        <InputText id="username" class="input" @bind-Value="_model.Username" disabled="@(!IsNew)" />
                        @if (!IsNew)
                        {
                            <span class="muted text-sm">Usernames can't be changed.</span>
                        }
                    </div>

                    <div class="field">
                        <label for="role">Role</label>
                        <InputSelect id="role" class="select" @bind-Value="_model.Role">
                            <option value="@Roles.CounterStaff">Counter staff</option>
                            <option value="@Roles.SuperAdmin">Super admin</option>
                        </InputSelect>
                    </div>
                    @if (_model.Role == Roles.CounterStaff)
                    {
                        <div class="field">
                            <label>Counter</label>
                            <LocationPicker Options="_counters" @bind-Value="_model.CounterLocationId" Placeholder="Assign a counter…" />
                        </div>
                    }

                    @if (IsNew)
                    {
                        <div class="field col-span-2">
                            <label for="pw">Starting password</label>
                            <InputText id="pw" class="input" type="text" @bind-Value="_model.Password" />
                            <span class="muted text-sm">At least 8 characters. Share it with the person; they can't change it themselves yet.</span>
                        </div>
                    }

                    <label class="checkline col-span-2">
                        <InputCheckbox @bind-Value="_model.IsActive" />
                        <span>Account is active</span>
                    </label>
                </div>

                @if (_error is not null)
                {
                    <div class="alert alert--error" style="margin-top: var(--space-4);" role="alert">@_error</div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn" disabled="@_saving">@(_saving ? "Saving…" : "Save account")</button>
                    <a class="btn btn--ghost" href="/staff/staff">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private StaffInput _model = new();
    private List<Location> _counters = [];
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _counters = await Locations.BoardingPointsAsync();

        if (Id is { } id)
        {
            var existing = await Staff.GetAsync(id);
            if (existing is null)
            {
                Nav.NavigateTo("/staff/staff");
                return;
            }
            _model = existing;
        }
        _loading = false;
    }

    private async Task Save()
    {
        _error = null;
        _saving = true;

        string? error;
        if (IsNew)
        {
            var r = await Staff.CreateAsync(_model);
            error = r.Succeeded ? null : r.Error;
        }
        else
        {
            var r = await Staff.UpdateAsync(_model);
            error = r.Succeeded ? null : r.Error;
        }

        _saving = false;
        if (error is null)
            Nav.NavigateTo("/staff/staff");
        else
            _error = error;
    }
}
