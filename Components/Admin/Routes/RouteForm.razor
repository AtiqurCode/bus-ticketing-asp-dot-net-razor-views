@page "/staff/routes/new"
@page "/staff/routes/{Id:guid}"
@rendermode RenderModes.ServerNoPrerender
@inject RouteService Routes
@inject LocationService Locations
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add route" : "Edit route")</PageTitle>

<PageHeading Title="@(IsNew ? "Add a route" : "Edit route")"
             Description="Distance and duration are estimates shown to passengers and used to compute arrival times." />

@if (_loading)
{
    <div class="loading-block">Loading…</div>
}
else
{
    <div class="card form-card">
        <div class="card__body">
            <EditForm Model="_model" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="field">
                        <label>Origin</label>
                        <LocationPicker Options="_points" @bind-Value="_model.OriginLocationId" Placeholder="Leaving from…" />
                    </div>
                    <div class="field">
                        <label>Destination</label>
                        <LocationPicker Options="_points" @bind-Value="_model.DestinationLocationId" Placeholder="Going to…" />
                    </div>

                    <div class="field">
                        <label for="distance">Distance (km)</label>
                        <InputNumber id="distance" class="input" @bind-Value="_model.DistanceKm" />
                        <ValidationMessage For="() => _model.DistanceKm" />
                    </div>
                    <div class="field">
                        <label for="duration">Duration (minutes)</label>
                        <InputNumber id="duration" class="input" @bind-Value="_model.ApproxDurationMinutes" />
                        <span class="muted text-sm">@DurationHint</span>
                    </div>

                    <label class="checkline col-span-2">
                        <InputCheckbox @bind-Value="_model.IsActive" />
                        <span>Open for scheduling and search</span>
                    </label>
                </div>

                @if (_error is not null)
                {
                    <div class="alert alert--error" style="margin-top: var(--space-4);" role="alert">@_error</div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn" disabled="@_saving">@(_saving ? "Saving…" : "Save route")</button>
                    <a class="btn btn--ghost" href="/staff/routes">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private RouteEditModel _model = new();
    private List<Location> _points = [];
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private bool IsNew => Id is null;

    private string DurationHint => _model.ApproxDurationMinutes > 0
        ? $"≈ {_model.ApproxDurationMinutes / 60}h {_model.ApproxDurationMinutes % 60:00}m"
        : "";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _points = await Locations.RoutePointsAsync();

        if (Id is { } id)
        {
            var existing = await Routes.GetAsync(id);
            if (existing is null)
            {
                Nav.NavigateTo("/staff/routes");
                return;
            }
            _model = RouteEditModel.From(existing);
        }
        _loading = false;
    }

    private async Task Save()
    {
        _error = null;
        _saving = true;

        var entity = _model.ToEntity();
        string? error;
        if (IsNew)
        {
            var r = await Routes.CreateAsync(entity);
            error = r.Succeeded ? null : r.Error;
        }
        else
        {
            entity.Id = Id!.Value;
            var r = await Routes.UpdateAsync(entity);
            error = r.Succeeded ? null : r.Error;
        }

        _saving = false;
        if (error is null)
            Nav.NavigateTo("/staff/routes");
        else
            _error = error;
    }

    private sealed class RouteEditModel
    {
        public Guid? OriginLocationId { get; set; }
        public Guid? DestinationLocationId { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, 2000, ErrorMessage = "0–2000 km.")]
        public decimal DistanceKm { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, 3000, ErrorMessage = "0–3000 minutes.")]
        public int ApproxDurationMinutes { get; set; }

        public bool IsActive { get; set; } = true;

        public static RouteEditModel From(BusRoute r) => new()
        {
            OriginLocationId = r.OriginLocationId,
            DestinationLocationId = r.DestinationLocationId,
            DistanceKm = r.DistanceKm,
            ApproxDurationMinutes = r.ApproxDurationMinutes,
            IsActive = r.IsActive
        };

        public BusRoute ToEntity() => new()
        {
            OriginLocationId = OriginLocationId ?? Guid.Empty,
            DestinationLocationId = DestinationLocationId ?? Guid.Empty,
            DistanceKm = DistanceKm,
            ApproxDurationMinutes = ApproxDurationMinutes,
            IsActive = IsActive
        };
    }
}
