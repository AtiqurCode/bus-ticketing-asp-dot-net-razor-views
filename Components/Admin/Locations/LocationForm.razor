@page "/staff/locations/new"
@page "/staff/locations/{Id:guid}"
@rendermode RenderModes.ServerNoPrerender
@inject LocationService Locations
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add stop" : "Edit stop")</PageTitle>

<PageHeading Title="@(IsNew ? "Add a stop" : $"Edit {_model.Name}")"
             Description="A city groups its terminals and counters. Terminals and counters must sit under a city." />

@if (_loading)
{
    <div class="loading-block">Loading…</div>
}
else
{
    <div class="card form-card">
        <div class="card__body">
            <EditForm Model="_model" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <div class="field">
                        <label for="type">Type</label>
                        <InputSelect id="type" class="select" @bind-Value="_model.Type" disabled="@(!IsNew)">
                            <option value="@LocationType.City">City</option>
                            <option value="@LocationType.Terminal">Terminal</option>
                            <option value="@LocationType.Counter">Counter</option>
                        </InputSelect>
                        @if (!IsNew)
                        {
                            <span class="muted text-sm">Type can't change after creation.</span>
                        }
                    </div>

                    @if (_model.Type != LocationType.City)
                    {
                        <div class="field">
                            <label for="parent">Parent city</label>
                            <InputSelect id="parent" class="select" @bind-Value="_model.ParentLocationId">
                                <option value="">— choose —</option>
                                @foreach (var city in _cities)
                                {
                                    <option value="@city.Id">@city.Name</option>
                                }
                            </InputSelect>
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <label for="division">Division</label>
                            <InputText id="division" class="input" @bind-Value="_model.Division" />
                        </div>
                        <div class="field">
                            <label for="district">District</label>
                            <InputText id="district" class="input" @bind-Value="_model.District" />
                        </div>
                    }

                    <div class="field">
                        <label for="name">Name (English)</label>
                        <InputText id="name" class="input" @bind-Value="_model.Name" />
                        <ValidationMessage For="() => _model.Name" />
                    </div>
                    <div class="field">
                        <label for="namebn">Name (বাংলা)</label>
                        <InputText id="namebn" class="input" @bind-Value="_model.NameBn" />
                    </div>

                    <label class="checkline col-span-2">
                        <InputCheckbox @bind-Value="_model.IsActive" />
                        <span>Available for routes and search</span>
                    </label>
                </div>

                @if (_error is not null)
                {
                    <div class="alert alert--error" style="margin-top: var(--space-4);" role="alert">@_error</div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn" disabled="@_saving">@(_saving ? "Saving…" : "Save stop")</button>
                    <a class="btn btn--ghost" href="/staff/locations">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private LocationEditModel _model = new();
    private List<Location> _cities = [];
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _cities = await Locations.CitiesAsync();

        if (Id is { } id)
        {
            var existing = await Locations.GetAsync(id);
            if (existing is null)
            {
                Nav.NavigateTo("/staff/locations");
                return;
            }
            _model = LocationEditModel.From(existing);
        }
        _loading = false;
    }

    private async Task Save()
    {
        _error = null;
        _saving = true;

        var entity = _model.ToEntity();
        string? error;

        if (IsNew)
        {
            var result = await Locations.CreateAsync(entity);
            error = result.Succeeded ? null : result.Error;
        }
        else
        {
            entity.Id = Id!.Value;
            var result = await Locations.UpdateAsync(entity);
            error = result.Succeeded ? null : result.Error;
        }

        _saving = false;
        if (error is null)
            Nav.NavigateTo("/staff/locations");
        else
            _error = error;
    }

    private sealed class LocationEditModel
    {
        public LocationType Type { get; set; } = LocationType.Terminal;
        public Guid? ParentLocationId { get; set; }
        public string Division { get; set; } = "";
        public string District { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter a name.")]
        [System.ComponentModel.DataAnnotations.MaxLength(120)]
        public string Name { get; set; } = "";

        public string? NameBn { get; set; }
        public bool IsActive { get; set; } = true;

        public static LocationEditModel From(Location l) => new()
        {
            Type = l.Type,
            ParentLocationId = l.ParentLocationId,
            Division = l.Division,
            District = l.District,
            Name = l.Name,
            NameBn = l.NameBn,
            IsActive = l.IsActive
        };

        public Location ToEntity() => new()
        {
            Type = Type,
            ParentLocationId = ParentLocationId,
            Division = Division,
            District = District,
            Name = Name,
            NameBn = NameBn,
            IsActive = IsActive
        };
    }
}
