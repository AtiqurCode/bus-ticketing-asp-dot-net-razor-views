@page "/staff/trips/new"
@page "/staff/trips/{Id:guid}"
@rendermode RenderModes.ServerNoPrerender
@inject TripService Trips
@inject RouteService Routes
@inject BusService Buses
@inject LocationService Locations
@inject IAppClock Clock
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add trip" : "Edit trip")</PageTitle>

<PageHeading Title="@(IsNew ? "Add a one-off trip" : "Edit trip")"
             Description="@(IsNew ? "For departures outside any schedule." : "Editing marks this trip as a manual override — the generator will leave it alone.")" />

@if (_loading)
{
    <div class="loading-block">Loading…</div>
}
else
{
    <div class="card form-card">
        <div class="card__body">
            <EditForm Model="_model" OnValidSubmit="Save">
                <div class="form-grid">
                    <div class="field">
                        <label for="route">Route</label>
                        <select id="route" class="select" value="@IdStr(_model.RouteId)" @onchange="e => _model.RouteId = ParseId(e.Value)">
                            <option value="">— choose —</option>
                            @foreach (var r in _routes)
                            {
                                <option value="@r.Id">@r.OriginLocation.Name → @r.DestinationLocation.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="bus">Bus</label>
                        <select id="bus" class="select" value="@IdStr(_model.BusId)" @onchange="e => _model.BusId = ParseId(e.Value)">
                            <option value="">— choose —</option>
                            @foreach (var b in _buses)
                            {
                                <option value="@b.Id">@b.Name — @b.Operator (@b.TotalSeats)</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="dep">Departure</label>
                        <input id="dep" type="datetime-local" class="input"
                               value="@_departureLocal" @onchange="OnDepartureChange" />
                    </div>
                    <div class="field">
                        <label for="fare">Fare (৳)</label>
                        <InputNumber id="fare" class="input" @bind-Value="_model.Fare" />
                    </div>

                    <div class="field">
                        <label>Boarding point</label>
                        <LocationPicker Options="_counters" @bind-Value="_model.BoardingCounterId" Placeholder="Optional" />
                    </div>
                    <div class="field">
                        <label>Dropping point</label>
                        <LocationPicker Options="_counters" @bind-Value="_model.DroppingCounterId" Placeholder="Optional" />
                    </div>
                </div>

                @if (_error is not null)
                {
                    <div class="alert alert--error" style="margin-top: var(--space-4);" role="alert">@_error</div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn" disabled="@_saving">@(_saving ? "Saving…" : "Save trip")</button>
                    <a class="btn btn--ghost" href="/staff/trips">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private ManualTripInput _model = new() { Fare = 0 };
    private List<BusRoute> _routes = [];
    private List<Bus> _buses = [];
    private List<Location> _counters = [];
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private bool IsNew => Id is null;
    private string _departureLocal = "";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _routes = await Routes.ActiveAsync();
        _buses = await Buses.ActiveForSchedulingAsync();
        _counters = await Locations.BoardingPointsAsync();

        if (Id is { } id)
        {
            var trip = await Trips.GetAsync(id);
            if (trip is null)
            {
                Nav.NavigateTo("/staff/trips");
                return;
            }
            _model = new ManualTripInput
            {
                Id = trip.Id,
                RouteId = trip.RouteId,
                BusId = trip.BusId,
                DepartureTime = trip.DepartureTime,
                Fare = trip.Fare,
                BoardingCounterId = trip.BoardingCounterId,
                DroppingCounterId = trip.DroppingCounterId
            };
            _departureLocal = Clock.ToLocal(trip.DepartureTime).ToString("yyyy-MM-ddTHH:mm");
        }
        else
        {
            var startLocal = Clock.ToLocal(Clock.UtcNow).DateTime.AddHours(2);
            _model.DepartureTime = Clock.ToInstant(startLocal);
            _departureLocal = startLocal.ToString("yyyy-MM-ddTHH:mm");
        }
        _loading = false;
    }

    private void OnDepartureChange(ChangeEventArgs e)
    {
        _departureLocal = (string?)e.Value ?? "";
        if (DateTime.TryParse(_departureLocal, out var local))
            _model.DepartureTime = Clock.ToInstant(local);
    }

    private static string IdStr(Guid value) => value == Guid.Empty ? "" : value.ToString();
    private static Guid ParseId(object? value) => Guid.TryParse(value?.ToString(), out var id) ? id : Guid.Empty;

    private async Task Save()
    {
        _error = null;
        _saving = true;

        string? error;
        if (IsNew)
        {
            var r = await Trips.CreateManualAsync(_model);
            error = r.Succeeded ? null : r.Error;
        }
        else
        {
            var r = await Trips.UpdateAsync(_model);
            error = r.Succeeded ? null : r.Error;
        }

        _saving = false;
        if (error is null)
            Nav.NavigateTo("/staff/trips");
        else
            _error = error;
    }
}
