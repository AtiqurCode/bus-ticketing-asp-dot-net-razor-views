<span class="badge @(Active ? "badge--success" : "")">
    <span class="status-dot @(Active ? "is-on" : "")" aria-hidden="true"></span>
    @(Active ? OnLabel : OffLabel)
</span>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public string OnLabel { get; set; } = "Active";
    [Parameter] public string OffLabel { get; set; } = "Inactive";
}
