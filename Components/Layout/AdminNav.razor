@inject IStringLocalizer<SharedResource> Loc

<nav class="anav" aria-label="Admin">
    @foreach (var section in Sections)
    {
        <div class="anav__group">
            @if (section.Heading is not null)
            {
                <span class="anav__heading">@section.Heading</span>
            }
            @foreach (var item in section.Items)
            {
                <AuthorizeView Policy="@(item.SuperAdminOnly ? AuthPolicies.SuperAdmin : AuthPolicies.BackOffice)">
                    <NavLink class="anav__link" href="@item.Href" Match="item.Match" onclick="AdminNav.close()">
                        <span class="anav__icon"><Icon Name="@item.Icon" Size="18" /></span>
                        <span>@item.Label</span>
                    </NavLink>
                </AuthorizeView>
            }
        </div>
    }
</nav>

@code {
    // Sections grow as each milestone lands a real page — every link here resolves.
    private IReadOnlyList<NavSection> Sections =>
    [
        new(null,
        [
            new("/staff", Loc["Admin.Nav.Dashboard"], "dashboard", NavLinkMatch.All)
        ]),
        new("Operations",
        [
            new("/staff/sell", Loc["Admin.Nav.Sell"], "plus-circle"),
            new("/staff/scan", Loc["Admin.Nav.Scan"], "scan"),
            new("/staff/bookings", Loc["Admin.Nav.Bookings"], "ticket"),
            new("/staff/payments", Loc["Admin.Nav.Payments"], "wallet"),
            new("/staff/trips", Loc["Admin.Nav.Trips"], "bus")
        ]),
        new("Planning",
        [
            new("/staff/schedules", Loc["Admin.Nav.Schedules"], "calendar", SuperAdminOnly: true),
            new("/staff/routes", Loc["Admin.Nav.Routes"], "route", SuperAdminOnly: true),
            new("/staff/buses", Loc["Admin.Nav.Buses"], "seat", SuperAdminOnly: true),
            new("/staff/locations", Loc["Admin.Nav.Locations"], "pin", SuperAdminOnly: true)
        ]),
        new("Administration",
        [
            new("/staff/staff", Loc["Admin.Nav.Staff"], "users", SuperAdminOnly: true),
            new("/staff/cancellation-policy", Loc["Admin.Nav.CancellationPolicy"], "rotate", SuperAdminOnly: true),
            new("/staff/settings", Loc["Admin.Nav.Settings"], "gear", SuperAdminOnly: true),
            new("/staff/audit", Loc["Admin.Nav.AuditLog"], "clipboard", SuperAdminOnly: true)
        ])
    ];

    private sealed record NavSection(string? Heading, IReadOnlyList<NavItem> Items);

    private sealed record NavItem(
        string Href, string Label, string Icon,
        NavLinkMatch Match = NavLinkMatch.Prefix, bool SuperAdminOnly = false);
}
