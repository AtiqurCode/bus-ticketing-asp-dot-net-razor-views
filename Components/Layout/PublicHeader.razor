@inject SettingsService Settings
@inject IStringLocalizer<SharedResource> Loc

<header class="hdr">
    <div class="container hdr__inner">
        <a href="/" class="hdr__brand" aria-label="@Settings.Current.SiteName">
            <span class="hdr__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 7.5C4 5.6 5.6 4 7.5 4h9C18.4 4 20 5.6 20 7.5v8.8c0 .9-.5 1.7-1.3 2.1l.3 1.1a1 1 0 0 1-1 1.3h-.7a1 1 0 0 1-1-.7l-.3-1.1H9l-.3 1.1a1 1 0 0 1-1 .7H7a1 1 0 0 1-1-1.3l.3-1.1A2.4 2.4 0 0 1 4 16.3V7.5Z" fill="currentColor"/>
                    <rect x="6.5" y="7" width="11" height="5" rx="1" fill="#fff"/>
                    <circle cx="8.2" cy="15.4" r="1.2" fill="#fff"/>
                    <circle cx="15.8" cy="15.4" r="1.2" fill="#fff"/>
                </svg>
            </span>
            <span class="hdr__name">@Settings.Current.SiteName</span>
        </a>

        <nav class="hdr__nav" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All">@Loc["Nav.Home"]</NavLink>
            <NavLink href="/search">@Loc["Nav.Search"]</NavLink>
            <NavLink href="/my-tickets">@Loc["Nav.MyTickets"]</NavLink>
            <NavLink href="/contact">@Loc["Nav.Contact"]</NavLink>
        </nav>

        <div class="hdr__actions">
            <LanguageSwitcher />
            <a href="/staff/login" class="hdr__staff">@Loc["Nav.StaffLogin"]</a>
        </div>

        <details class="hdr__menu">
            <summary aria-label="Menu">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                </svg>
            </summary>
            <div class="hdr__menu-panel">
                <NavLink href="/" Match="NavLinkMatch.All">@Loc["Nav.Home"]</NavLink>
                <NavLink href="/search">@Loc["Nav.Search"]</NavLink>
                <NavLink href="/my-tickets">@Loc["Nav.MyTickets"]</NavLink>
                <NavLink href="/contact">@Loc["Nav.Contact"]</NavLink>
                <a href="/staff/login">@Loc["Nav.StaffLogin"]</a>
            </div>
        </details>
    </div>
</header>
