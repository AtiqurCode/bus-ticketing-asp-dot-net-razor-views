# Copy to .env and change the values before any real deployment.
# docker compose reads .env automatically.

# Postgres superuser password (used by the db container and the app's connection string)
POSTGRES_PASSWORD=busticketing_dev

# Password the seeded super-admin account ("admin") is created with on first boot
SUPERADMIN_PASSWORD=ChangeMe!2026

# true → seed a sample fleet, routes, schedules and a week of trips on first boot,
# so the app is immediately testable. Leave false for a real deployment.
SEED_DEMO=false

# Host ports (change if 8080 / 5433 are taken)
APP_PORT=8080
DB_PORT=5433
